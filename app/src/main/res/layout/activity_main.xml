<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#AECBDD">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="iBEACON SCANNER FINAL" android:textStyle="bold"
            android:textSize="18sp" android:textColor="#000000" />

        <!-- Sumber data -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Sumber data:"
            android:textStyle="bold" android:textColor="#000000" />

        <RadioGroup android:id="@+id/rgSource"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbBle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Bluetooth" android:checked="true" />
            <RadioButton android:id="@+id/rbRs232" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="RS232" />
            <RadioButton android:id="@+id/rbCl" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Current Loop" />
        </RadioGroup>

        <!-- Panel Bluetooth -->
        <LinearLayout android:id="@+id/panelBle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Filter berdasarkan:"
                android:textColor="#000000" />

            <RadioGroup android:id="@+id/rgFilter"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbName" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Nama" android:checked="true" />
                <RadioButton android:id="@+id/rbUuid" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="UUID" />
                <RadioButton android:id="@+id/rbMac" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="MAC" />
            </RadioGroup>

            <EditText android:id="@+id/etFilter"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="ESP32-KANAN"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:singleLine="true" android:textSize="15sp" />
        </LinearLayout>

        <!-- Panel RS232 / Current Loop -->
        <LinearLayout android:id="@+id/panelSerial"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">

            <TextView android:id="@+id/tvSerialHint"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="#333333" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                    android:text="Baud" android:textColor="#000000" />
                <Spinner android:id="@+id/spBaud"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                    android:text="Frame" android:textColor="#000000" />
                <Spinner android:id="@+id/spFrame"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                    android:text="Format" android:textColor="#000000" />
                <Spinner android:id="@+id/spProtocol"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <EditText android:id="@+id/etCmd"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Perintah minta berat (kosong = kontinu), mis. R\\r\\n"
                android:inputType="textNoSuggestions" android:singleLine="true"
                android:textSize="14sp" />

            <CheckBox android:id="@+id/cbStable"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hanya tampilkan berat stabil" />
        </LinearLayout>

        <Button android:id="@+id/btnScan"
            android:layout_width="140dp" android:layout_height="90dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
            android:text="Scan" />

        <TextView android:id="@+id/tvMajor"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Major : -"
            android:textStyle="bold" android:textSize="18sp" android:textColor="#000000" />

        <TextView android:id="@+id/tvMinor"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Minor : -"
            android:textStyle="bold" android:textSize="18sp" android:textColor="#000000" />

        <TextView android:id="@+id/tvWeight"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Beratnya = - KG"
            android:textStyle="bold" android:textSize="22sp" android:textColor="#000000" />

        <TextView android:id="@+id/tvInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textIsSelectable="true"
            android:fontFamily="monospace" android:textSize="13sp" android:textColor="#222222" />

        <TextView android:id="@+id/tvStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Siap"
            android:textSize="14sp" android:textColor="#333333" />
    </LinearLayout>
</ScrollView>
